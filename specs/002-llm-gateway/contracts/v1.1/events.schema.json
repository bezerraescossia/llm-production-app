{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-services.local/contracts/v1/events.schema.json",
  "title": "AI-Services SSE event payloads (contract 1.x)",
  "description": "Each SSE frame has `id` (sequence from 0, no gaps), `event` (one of the types below) and `data` (the JSON payload for that type). Every stream ends with exactly one terminal event (done or error). tool_call and tool_result are informational for the client. Contract 1.1.0: usage token counts may be null when the provider did not report them; clients must tolerate null.",
  "oneOf": [
    {
      "$ref": "#/$defs/token"
    },
    {
      "$ref": "#/$defs/tool_call"
    },
    {
      "$ref": "#/$defs/tool_result"
    },
    {
      "$ref": "#/$defs/citation"
    },
    {
      "$ref": "#/$defs/usage"
    },
    {
      "$ref": "#/$defs/done"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "token"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "text"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "tool_call"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "arguments"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          }
        }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "tool_result"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "status": {
              "enum": [
                "ok",
                "error"
              ]
            },
            "content": {
              "type": "string"
            }
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "citation"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "title"
          ],
          "properties": {
            "source_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "usage"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "cost_usd"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "done"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finish_reason"
          ],
          "properties": {
            "finish_reason": {
              "enum": [
                "stop",
                "length",
                "blocked",
                "cancelled"
              ]
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "data"
      ],
      "properties": {
        "event": {
          "const": "error"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
