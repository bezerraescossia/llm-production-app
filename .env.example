# Copy to .env and fill in. Never commit .env.

# 1-2 service tokens, comma separated, each at least 32 characters (two allowed during rotation)
SERVICE_TOKENS=change-me-to-a-random-string-of-at-least-32-chars

# name=host:port pairs probed by readiness
READINESS_DEPENDENCIES=postgres=postgres:5432,redis=redis:6379,qdrant=qdrant:6333

MAX_REQUEST_BYTES=262144
MAX_MESSAGES=100
SHUTDOWN_GRACE_SECONDS=20
PLACEHOLDER_TOKEN_DELAY_MS=0
LOG_LEVEL=INFO

# Swagger UI at /v1/docs (development only; leave false in production)
ENABLE_DOCS=false

# LLM gateway (optional). Without GATEWAY_CONFIG every tier is served by the built-in stub, which
# needs no credentials. To use real models: copy config/gateway.example.yaml to
# config/gateway.local.yaml, edit it, and set the path below. Credentials are only read for the
# providers the file uses.
# GATEWAY_CONFIG=config/gateway.local.yaml
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
